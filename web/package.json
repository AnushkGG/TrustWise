{
  "name": "trustwise-web",
  "version": "1.0.0",
  "description": "TrustWise TypeScript web server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/main.ts --bundle --outfile=../static/js/main.js --platform=browser --target=es2020",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js"
  },
  "keywords": [
    "trustwise",
    "ai",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^25.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2"
  }
}
