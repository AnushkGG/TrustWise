# Default: local Ollama (install from https://ollama.com — then: ollama pull llama3.2)
LLM_PROVIDER=ollama
# For Linux/Windows: use http://localhost:11434
# For Docker (Linux/Windows/Mac): use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# Google Gemini (cloud) — copy this block into your local .env (never commit .env).
# If a key was ever pasted into chat or committed, rotate it in Google AI Studio / Cloud Console.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_new_rotated_key_here
# GEMINI_MODEL=gemini-2.0-flash
# (Optional) If unset, Config.get_gemini_model() falls back to LLM_MODEL.
# LLM_MODEL=gemini-2.0-flash

# Combined mode: call both providers in parallel and merge results.
# Requires GEMINI_API_KEY and a running Ollama server.
# Each task/key-point in the output carries an "origin" tag (gemini, ollama, or both).
# LLM_PROVIDER=both
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash    # per-provider model override (falls back to LLM_MODEL)
# OLLAMA_MODEL=llama3.2             # per-provider model override (falls back to LLM_MODEL)

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# Agent Settings
WEB_SCRAPER_TIMEOUT=10
ARXIV_MAX_RESULTS=5
RESEARCH_ARXIV_MAX=5
RESEARCH_OPENALEX_MAX=5
RESEARCH_SEMANTIC_SCHOLAR_MAX=5
RESEARCH_CROSSREF_MAX=5
RESEARCH_PUBMED_MAX=5
RESEARCH_CORE_MAX=5
RESEARCH_DOAJ_MAX=5
RESEARCH_BASE_MAX=5
RESEARCH_BIORXIV_MAX=5
RESEARCH_MEDRXIV_MAX=5
RESEARCH_TOTAL_MAX=15
RESEARCH_SOURCE_TIMEOUT=15
RESEARCH_MAX_WORKERS=6
RESEARCH_PER_SOURCE_RETRIES=2
# OpenAlex polite pool — set a real contact email for production
OPENALEX_MAILTO=mailto:dev@localhost
ENABLE_SOURCE_ARXIV=true
ENABLE_SOURCE_OPENALEX=true
ENABLE_SOURCE_SEMANTIC_SCHOLAR=true
ENABLE_SOURCE_CROSSREF=true
ENABLE_SOURCE_PUBMED=true
ENABLE_SOURCE_CORE=true
ENABLE_SOURCE_DOAJ=true
ENABLE_SOURCE_BASE=true
ENABLE_SOURCE_BIORXIV=true
ENABLE_SOURCE_MEDRXIV=true

# Optional API keys for extended 37-tool integration
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# JINA_API_KEY=
# CORE_API_KEY=
# DEEPSEEK_API_KEY=
# SCOPUS_API_KEY=
# Optional: enable Jina s.jina.ai search in research fanout without JINA_API_KEY (rate limits apply).
# JINA_SEARCH_ALLOW_KEYLESS=false

# Legacy Flask app (python app.py) — optional
FLASK_DEBUG=false

# Persistence
SAVE_PLANS=true
SAVE_RAW_DATA=true
SAVE_STRUCTURED_DATA=true
SAVE_TRUSTED_DATA=true
SAVE_TO_DB=true
ENABLE_DB_CACHE=true
DB_CACHE_MIN_ITEMS=3
ALLOW_MOCK_FALLBACK=false

LOG_LEVEL=INFO

# TypeScript web server (web/src/server.ts)
# PORT=5000
# HOST=127.0.0.1
