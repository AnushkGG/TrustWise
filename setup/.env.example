# TrustWise environment configuration (example)
#
# Usage:
#   - Copy this file to `.env`
#   - Fill in any keys you want to enable (leave others blank)
#   - Never commit real secrets (the repo already gitignores `.env`)
#
# ---------------------------------------------------------------------------
# Web server (Express)
# ---------------------------------------------------------------------------
# Native default is 127.0.0.1; inside Docker you typically want 0.0.0.0
HOST=127.0.0.1
PORT=5000

# Python executable for the web server to call `api_bridge.py`.
# Only needed when `python` on PATH is not the right interpreter.
PYTHON_EXE=
TRUSTWISE_PYTHON=

# ---------------------------------------------------------------------------
# LLM configuration
# ---------------------------------------------------------------------------
# Provider options: ollama, gemini, both
LLM_PROVIDER=ollama

# Shared/default model name (can be overridden per provider below)
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# When false, runtime never returns synthetic mock plans/data.
ALLOW_MOCK_FALLBACK=false

# --- Ollama (local) ---
# Native example: http://localhost:11434
# Docker example (Ollama running on the host): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Gemini (cloud) ---
# Required when LLM_PROVIDER is gemini or both
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

SAVE_PLANS=true
SAVE_RAW_DATA=true
SAVE_STRUCTURED_DATA=true
SAVE_TRUSTED_DATA=true
SAVE_TO_DB=true

ENABLE_DB_CACHE=true
DB_CACHE_MIN_ITEMS=3

# ---------------------------------------------------------------------------
# Agent timeouts & tuning
# ---------------------------------------------------------------------------
WEB_SCRAPER_TIMEOUT=10

CITATION_MAX_SOURCES=12
CITATION_PAGES_PER_SOURCE=2

RESEARCH_TOTAL_MAX=15
RESEARCH_MAX_WORKERS=6
RESEARCH_SOURCE_TIMEOUT=15
RESEARCH_PER_SOURCE_RETRIES=2

# OpenAlex polite pool: include a contact in User-Agent (set your email in prod)
OPENALEX_MAILTO=mailto:dev@localhost

# ---------------------------------------------------------------------------
# Source toggles (set to false to disable a source quickly)
# ---------------------------------------------------------------------------
ENABLE_SOURCE_ARXIV=true
ENABLE_SOURCE_OPENALEX=true
ENABLE_SOURCE_SEMANTIC_SCHOLAR=true
ENABLE_SOURCE_CROSSREF=true
ENABLE_SOURCE_PUBMED=true
ENABLE_SOURCE_CORE=true
ENABLE_SOURCE_DOAJ=true
ENABLE_SOURCE_BASE=true
ENABLE_SOURCE_BIORXIV=true
ENABLE_SOURCE_MEDRXIV=true

# ---------------------------------------------------------------------------
# Optional keyed providers (only enable if you have keys)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
CORE_API_KEY=
DEEPSEEK_API_KEY=
SCOPUS_API_KEY=

# Allow Jina s.jina.ai search without API key (rate limits may apply)
JINA_SEARCH_ALLOW_KEYLESS=false
