# LLM Configuration
LLM_PROVIDER=gemini

# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Or use a local Ollama model (no API key needed):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# Agent Settings
WEB_SCRAPER_TIMEOUT=10
ARXIV_MAX_RESULTS=5

# Legacy Flask app (python app.py) — optional
# FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Persistence: plans, raw agent JSON, normalized JSON, trust reports, SQLite
SAVE_PLANS=true
SAVE_RAW_DATA=true
SAVE_STRUCTURED_DATA=true
SAVE_TRUSTED_DATA=true
SAVE_TO_DB=true

# Reuse prior trusted rows from SQLite for the same query when enough items exist (skips agent run)
ENABLE_DB_CACHE=true
DB_CACHE_MIN_ITEMS=3

LOG_LEVEL=INFO

# TypeScript web server (web/src/server.ts) — optional overrides
# PORT=5000
# HOST=127.0.0.1
