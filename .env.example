# LLM Configuration
LLM_PROVIDER=gemini

# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Or use a local Ollama model (no API key needed):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# Agent Settings
WEB_SCRAPER_TIMEOUT=10
ARXIV_MAX_RESULTS=5

# Flask Settings
# Generate a unique secret key for production use (e.g., python -c "import secrets; print(secrets.token_hex(32))")
# FLASK_SECRET_KEY=change_me_in_production
# Set to true only for local development
FLASK_DEBUG=false

# System Settings
SAVE_PLANS=true
SAVE_RAW_DATA=true
LOG_LEVEL=INFO
